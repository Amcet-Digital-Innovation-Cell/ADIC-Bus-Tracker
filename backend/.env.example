# ─────────────────────────────────────────────────────────────
# AmcetTransit Bus Tracking Backend — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# On Render: set these in Dashboard → Environment tab.
# NEVER commit the actual .env file to git.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────
# Set to your Vercel frontend URL in production.
# Leave as * for local development.
FRONTEND_URL=*
# Production example:
# FRONTEND_URL=https://your-app.vercel.app

# ── Supabase ──────────────────────────────────────────────────
# Find in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── SkyNav GPS Credentials ────────────────────────────────────
# Provided by SkyNav after your IMEI is whitelisted.
# Without these, the GPS scheduler runs but skips sync cycles.
SKYNAV_API_URL=https://api.skynav.in/v1
SKYNAV_BEARER_TOKEN=your-bearer-token-here
SKYNAV_USERNAME=your-username
SKYNAV_PASSWORD=your-password
SKYNAV_PROJECT_ID=your-project-id
SKYNAV_COMPANY_NAME=your-company-name
SKYNAV_IMEI=                          # Optional: specific IMEI, leave blank for all devices

# ── GPS Polling ───────────────────────────────────────────────
# Interval in milliseconds between GPS sync cycles.
# Default: 30000 (30 seconds)
GPS_POLL_INTERVAL_MS=30000
