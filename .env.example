# ─── Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# Frontend URL(s) — comma-separated for multiple domains
FRONTEND_URL=https://your-frontend.vercel.app

# ─── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# IMPORTANT: NEVER commit this key. Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── SkyNav GPS API ─────────────────────────────────────────────────────────
SKYNAV_API_URL=https://api.skynavgps.com/v2
SKYNAV_USERNAME=your-username
SKYNAV_PASSWORD=your-password
SKYNAV_PROJECT_ID=49
SKYNAV_COMPANY_NAME=SkyNav PRO DEMO
SKYNAV_IMEI=your-imei-here

# Bearer token is OPTIONAL — the demo credentials work without it.
# Only set this if SkyNav support requires it for production.
# SKYNAV_BEARER_TOKEN=your-bearer-token-here

# ─── GPS Polling ────────────────────────────────────────────────────────────
# Demo SkyNav API rate limit: 1 request per minute → use 60000 or more.
# Production API may allow shorter intervals — confirm with SkyNav support.
GPS_POLL_INTERVAL_MS=60000
