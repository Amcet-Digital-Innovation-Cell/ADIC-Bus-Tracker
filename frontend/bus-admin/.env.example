# ─────────────────────────────────────────────────────────────
# AmcetTransit Bus Tracking Frontend — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# On Vercel: set these in Dashboard → Settings → Environment Variables.
# All variables MUST start with VITE_ to be accessible in the browser.
# NEVER commit the actual .env file to git.
# ─────────────────────────────────────────────────────────────

# ── Backend API ───────────────────────────────────────────────
# Your Render backend URL (no trailing slash)
VITE_API_URL=https://bus-tracking-zbon.onrender.com

# ── Supabase (Authentication only) ───────────────────────────
# Find in: Supabase Dashboard → Settings → API
# These are safe to expose in the browser (they are public keys).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
